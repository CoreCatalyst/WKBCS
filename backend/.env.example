# ─────────────────────────────────────────────────────────────
#  NORYVANTA.IN BACKEND — PRODUCTION & LOCAL ENVIRONMENT CONFIG
# ─────────────────────────────────────────────────────────────

# Application
APP_ENV=development
PROJECT_NAME="Noryvanta Business Marketplace"
API_V1_STR=/api/v1
SECRET_KEY=change_me_super_secret_key_at_least_64_chars_long_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database (PostgreSQL / Supabase)
# SQLite for local dev without external services:
DATABASE_URL=sqlite+aiosqlite:///./noryvanta.db
# Production Supabase PostgreSQL connection string example:
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Redis & Background Tasks (Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Regulatory Tax & Platform Fee Defaults (Category-based Business-side fee, 1% TDS)
PLATFORM_FEE_WHOLESALER=3.20
PLATFORM_FEE_DISTRIBUTOR=5.20
PLATFORM_FEE_SERVICES=5.20
PLATFORM_FEE_RETAILER=8.20
PLATFORM_COMMISSION_PERCENT=5.20
TDS_SECTION_194O_PERCENT=1.0
DEFAULT_GST_RATE_PERCENT=18.0

# Listing Rules (Section H: minimum 6 images enforced server-side)
MINIMUM_LISTING_IMAGES=6
MAXIMUM_LISTING_IMAGES=12

# Authentication & OTP Mode
# DEV MODE: console/test OTP; PRODUCTION: SMS provider
DEV_MODE_OTP=true

# Payment Gateway: Razorpay (Sandbox/Test keys in development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Payment Gateway: Cashfree (Sandbox/Test keys in development)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# AI Listing Assistant (Gemini / OpenAI Provider Abstraction)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Email Provider: Resend (3,000/month free tier)
RESEND_API_KEY=
EMAIL_FROM=Noryvanta <notifications@noryvanta.in>

# Social Authentication: Google Login (Google OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bot Protection & CAPTCHA: Cloudflare Turnstile
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Location & Address Geocoding: Google Maps
GOOGLE_MAPS_API_KEY=

# Push Notifications: Firebase Cloud Messaging (FCM)
FIREBASE_FCM_CREDENTIALS=
FIREBASE_PROJECT_ID=noryvanta-prod

# Object Storage: Supabase Storage / AWS S3
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=noryvanta-assets
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Supabase SDK Keys (Optional direct client access)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
