# ─────────────────────────────────────────────────────────────────────────────
#  NORYVANTAGLOBAL.COM BACKEND — PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
#  Strict Zero-Mock Production Configuration with Live API Keys
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Core Application & Security ──────────────────────────────────────────
APP_ENV=production
PROJECT_NAME="Noryvanta Global B2B Marketplace"
API_V1_STR=/api/v1

# Security: Generate a 64+ char random hex key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Allowed Origins (Comma-separated exact domains — NO wildcards)
CORS_ALLOWED_ORIGINS=https://noryvantaglobal.com,https://www.noryvantaglobal.com,https://admin.noryvantaglobal.com

# Strictly disable local OTP preview & seed demo data in production
DEV_MODE_OTP=false
SEED_DEMO_DATA=false

# ── 2. Production Database (PostgreSQL / Supabase / AWS RDS) ─────────────────
# Connection pool with asyncpg driver:
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR_DB_PASSWORD]@[YOUR_DB_HOST]:5432/postgres

# ── 3. Distributed Cache & Celery Task Broker (Redis) ─────────────────────────
REDIS_URL=rediss://default:[PASSWORD]@[HOST]:6379/0
CELERY_BROKER_URL=rediss://default:[PASSWORD]@[HOST]:6379/1
CELERY_RESULT_BACKEND=rediss://default:[PASSWORD]@[HOST]:6379/2

# ── 4. Indian Mobile SMS & DLT Transactional OTP (MSG91) ─────────────────────
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=NORYVT
MSG91_TEMPLATE_ID=
MSG91_DLT_TE_ID=
MSG91_ROUTE=4
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_SECONDS=60

# ── 5. Payment Gateways (Razorpay & Cashfree Live Credentials) ───────────────
# Razorpay Production Keys
RAZORPAY_KEY_ID=rzp_live_
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree Production Keys
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# ── 6. Transactional Email Delivery (Resend) ──────────────────────────────────
RESEND_API_KEY=re_
EMAIL_FROM="Noryvanta Global <support@noryvantaglobal.com>"

# ── 7. AI Commerce Studio & Grounding Fact Engine (Gemini / OpenAI) ──────────
AI_PROVIDER=gemini
GEMINI_API_KEY=
# OPENAI_API_KEY=

# ── 8. Cloud Object Storage (Supabase Storage / AWS S3) ──────────────────────
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=noryvanta-assets
STORAGE_REGION=ap-south-1
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_SIGNED_URL_EXPIRES_SECONDS=900

# ── 9. Bot Protection & Human Verification (Cloudflare Turnstile) ────────────
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ── 10. Maps Geocoding & Business Address Pinning (Google Maps Platform) ─────
GOOGLE_MAPS_API_KEY=

# ── 11. Social Identity Authentication (Google OAuth SSO) ─────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 12. Push Notifications (Firebase Cloud Messaging - FCM v1) ───────────────
FIREBASE_PROJECT_ID=
FIREBASE_FCM_CREDENTIALS=
