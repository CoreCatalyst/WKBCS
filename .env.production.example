# ─────────────────────────────────────────────────────────────────────────────
#  NORYVANTAGLOBAL.COM — FULL-STACK PRODUCTION CONFIGURATION TEMPLATE
# ─────────────────────────────────────────────────────────────────────────────

# ── Application Environment ──
APP_ENV=production
PROJECT_NAME="Noryvanta Global Marketplace"
API_BASE_URL=https://api.noryvantaglobal.com
FRONTEND_URL=https://noryvantaglobal.com

# ── Core Security & JWT ──
SECRET_KEY=
JWT_ALGORITHM=HS256
DEV_MODE_OTP=false
SEED_DEMO_DATA=false

# ── PostgreSQL Database ──
DATABASE_URL=postgresql+asyncpg://postgres:[DB_PASSWORD]@[DB_HOST]:5432/postgres

# ── Redis Cache & Broker ──
REDIS_URL=rediss://default:[PASSWORD]@[HOST]:6379/0
CELERY_BROKER_URL=rediss://default:[PASSWORD]@[HOST]:6379/1
CELERY_RESULT_BACKEND=rediss://default:[PASSWORD]@[HOST]:6379/2

# ── Indian Mobile SMS & OTP (MSG91) ──
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=NORYVT
MSG91_TEMPLATE_ID=
MSG91_DLT_TE_ID=

# ── Payment Gateways (Razorpay & Cashfree) ──
RAZORPAY_KEY_ID=rzp_live_
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# ── AI Listing Engine (Google Gemini) ──
AI_PROVIDER=gemini
GEMINI_API_KEY=

# ── Transactional Email (Resend) ──
RESEND_API_KEY=re_
EMAIL_FROM="Noryvanta Global <support@noryvantaglobal.com>"

# ── Cloud Object Storage (Supabase Storage) ──
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=noryvanta-assets
STORAGE_REGION=ap-south-1
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare Turnstile CAPTCHA ──
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ── Google Cloud APIs ──
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Push Notifications (Firebase FCM) ──
FIREBASE_PROJECT_ID=
FIREBASE_FCM_CREDENTIALS=
