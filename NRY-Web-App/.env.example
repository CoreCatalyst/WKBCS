# ─────────────────────────────────────────────────────────────
#  NORYVANTA.IN FRONTEND — ENVIRONMENT CONFIG (.env.example)
# ─────────────────────────────────────────────────────────────

# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Frontend App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Client SDK (Optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Payment Gateway Public Keys (Client-side checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_noryvanta_sandbox
NEXT_PUBLIC_CASHFREE_APP_ID=cf_test_noryvanta_sandbox

# Bot Protection
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
