# ─────────────────────────────────────────────────────────────
#  NORYVANTAGLOBAL.COM FRONTEND — ENVIRONMENT CONFIG (.env.example)
# ─────────────────────────────────────────────────────────────

# Backend API Base URL (Point to production backend domain)
NEXT_PUBLIC_API_URL=https://api.noryvantaglobal.com/api/v1
NEXT_PUBLIC_API_BASE_URL=https://api.noryvantaglobal.com/api/v1

# Frontend App URL
NEXT_PUBLIC_APP_URL=https://noryvantaglobal.com

# Supabase Client SDK
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Payment Gateway Public Keys (Client-side checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_CASHFREE_APP_ID=

# Bot Protection (Cloudflare Turnstile)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=

# Google Maps API Key (Client-side location / address picker)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
