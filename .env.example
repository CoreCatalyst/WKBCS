# ─────────────────────────────────────────────────────────────
#  Noryvanta Business Marketplace Platform — Environment Config
# ─────────────────────────────────────────────────────────────

# ── Application ──
APP_ENV=development
APP_NAME=Noryvanta Business Marketplace
APP_VERSION=1.0.0
APP_DEBUG=true
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── Security ──
SECRET_KEY=change_me_super_secret_key_at_least_64_chars_long_for_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (PostgreSQL) ──
DB_PASSWORD=noryvanta_dev
DATABASE_URL=postgresql+asyncpg://noryvanta:noryvanta_dev@localhost:5432/noryvanta

# ── Redis ──
REDIS_PASSWORD=redis_dev
REDIS_URL=redis://:redis_dev@localhost:6379/0

# ── Celery ──
CELERY_BROKER_URL=redis://:redis_dev@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:redis_dev@localhost:6379/2

# ── SMS / OTP (MSG91) ──
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_otp_template_id
MSG91_SENDER_ID=NORYVT
OTP_EXPIRY_SECONDS=300

# ── Email (SMTP / AWS SES) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@noryvanta.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_TLS=true
EMAIL_FROM=Noryvanta <noreply@noryvanta.com>

# ── AWS / Cloud ──
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=noryvanta-documents
S3_BUCKET_URL=https://noryvanta-documents.s3.ap-south-1.amazonaws.com
KMS_KEY_ID=your_kms_key_id

# ── Supabase (Optional Managed DB) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ── Payment / Escrow ──
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
ESCROW_INSPECTION_WINDOW_HOURS=48
PLATFORM_FEE_PERCENT=3.0
GST_RATE_PERCENT=18.0

# ── KYC / AML ──
SIGNZY_API_KEY=your_signzy_api_key
SIGNZY_BASE_URL=https://preproduction.signzy.app/api/v2
AADHAAR_BRIDGE_KEY=your_aadhaar_bridge_key

# ── GST Verification (Sandbox) ──
GST_API_URL=https://api.mastergst.com/einvoice
GST_CLIENT_ID=your_client_id
GST_CLIENT_SECRET=your_client_secret
GST_GSTIN=29NORYVANTA1Z5

# ── Monitoring ──
PROMETHEUS_ENABLED=true
SENTRY_DSN=https://your_sentry_dsn@o12345.ingest.sentry.io/12345
GRAFANA_PASSWORD=grafana_dev

# ── OpenSearch / Logs ──
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_PREFIX=noryvanta

# ── NextAuth (Frontend) ──
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=nextauth_dev_secret_change_in_prod

# ── Flower (Celery Dashboard) ──
FLOWER_PASSWORD=flower_dev

# ── CORS ──
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://noryvanta.com

# ── Rate Limiting ──
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20
