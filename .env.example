# ─────────────────────────────────────────────────────────────
#  NORYVANTA.IN — FULL STACK ENVIRONMENT CONFIG (.env.example)
# ─────────────────────────────────────────────────────────────

# ── Application ──
APP_ENV=development
APP_NAME="Noryvanta Business Marketplace"
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── Database (PostgreSQL / Supabase) ──
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./noryvanta.db
# Production Supabase PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── Redis & Background Jobs (Celery) ──
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Security & Authentication ──
SECRET_KEY=change_me_super_secret_key_at_least_64_chars_long_for_production
JWT_ALGORITHM=HS256
DEV_MODE_OTP=true

# ── Payment Gateways (Razorpay & Cashfree) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# ── AI Listing Assistant (Gemini & OpenAI) ──
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Email Service (Resend) ──
RESEND_API_KEY=
EMAIL_FROM=Noryvanta <notifications@noryvanta.in>

# ── Social Authentication (Google OAuth) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Security & Bot Protection (Cloudflare Turnstile) ──
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ── Geocoding & Address Verification (Google Maps) ──
GOOGLE_MAPS_API_KEY=

# ── Push Notifications (Firebase FCM) ──
FIREBASE_FCM_CREDENTIALS=
FIREBASE_PROJECT_ID=noryvanta-prod

# ── Cloud Object Storage (Supabase Storage / AWS S3) ──
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=noryvanta-assets
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── Supabase (Optional Direct SDK) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
